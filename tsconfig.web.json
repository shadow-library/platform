{
  // "paths": {"@/*": ["./src/*"]} is NOT hoisted here even though it's identical across the 4 web
  // apps: TypeScript resolves relative "paths" values against the config file that *declares* them,
  // not the extending file, so putting it here would repoint every app's "@/*" at <root>/src/*. It
  // stays declared in each app's own tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "strictPropertyInitialization": true,

    "verbatimModuleSyntax": true
  }
}
