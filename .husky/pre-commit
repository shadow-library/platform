# Map staged files to the target(s) they touch (apps/<x>, packages/<x>, e2e, or the root tooling),
# deduplicated. Root-level configs verify as part of the `scripts` target, so a change to one picks it up.
targets="$(git diff --cached --name-only --diff-filter=ACMR | sed -nE 's#^(apps/[^/]+|packages/[^/]+|e2e)/.*#\1#p; s#^(scripts/.*|[^/]+\.(ts|json|md))$#scripts#p' | sort -u)"

if [ -z "$targets" ]; then
  exit 0
fi

# Fast (format + lint only, no type-check/test -- that's CI's job) verify, scoped to each changed target
# instead of the whole platform, so pre-commit stays quick even as the monorepo grows.
status=0
for target in $targets; do
  echo "pre-commit: verify --fast ($target)"
  bun scripts/verify.ts "$target" --fast || status=1
done

exit $status
