{
  "name": "@shadow-library/auth",
  "type": "module",
  "version": "0.3.1-alpha.0",
  "description": "Shadow Apps consumer auth SDK — Bun-native EdDSA token verification, PDP client, M2M tokens, OIDC relying-party helper, and framework guards",
  "exports": {
    ".": "./src/index.ts",
    "./module": "./src/module/index.ts",
    "./rp": "./src/rp/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "rm -rf dist logs CHANGELOG.md",
    "verify": "shadow verify",
    "type-check": "tsc",
    "test": "bun test",
    "build": "shadow build",
    "pack": "bun run build && cd dist && bun pm pack --destination .."
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/auth.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shadow-library/auth/issues"
  },
  "homepage": "https://github.com/shadow-library/auth#readme",
  "peerDependencies": {
    "@shadow-library/app": "2.0.0-alpha.0",
    "@shadow-library/common": "2.0.0-alpha.4",
    "@shadow-library/fastify": "2.0.0-alpha.0"
  },
  "peerDependenciesMeta": {
    "@shadow-library/app": {
      "optional": true
    },
    "@shadow-library/fastify": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shadow-library/app": "2.0.0-alpha.0",
    "@shadow-library/common": "2.0.0-alpha.4",
    "@shadow-library/fastify": "2.0.0-alpha.0",
    "@shadow-library/scripts": "0.3.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.9.2",
    "husky": "^9.1.7",
    "reflect-metadata": "^0.2.2"
  }
}
