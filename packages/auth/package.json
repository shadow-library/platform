{
  "name": "@shadow-library/auth",
  "private": true,
  "type": "module",
  "version": "0.4.0-alpha.4",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "default": "./dist/module/index.js"
    },
    "./rp": {
      "types": "./dist/rp/index.d.ts",
      "default": "./dist/rp/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "description": "Shadow Apps consumer auth SDK — Bun-native EdDSA token verification, PDP client, M2M tokens, OIDC relying-party helper, and framework guards",
  "scripts": {
    "clean": "rm -rf dist logs CHANGELOG.md",
    "verify": "bun ../../scripts/src/bin/shadow.ts verify",
    "type-check": "tsc",
    "test": "bun test",
    "build": "bun ../../scripts/src/bin/shadow.ts build",
    "pack": "bun run build && cd dist && bun pm pack --destination .."
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/auth.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shadow-library/auth/issues"
  },
  "homepage": "https://github.com/shadow-library/auth#readme",
  "peerDependencies": {
    "@shadow-library/app": "workspace:*",
    "@shadow-library/class-schema": "workspace:*",
    "@shadow-library/common": "workspace:*",
    "@shadow-library/fastify": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@shadow-library/app": {
      "optional": true
    },
    "@shadow-library/fastify": {
      "optional": true
    },
    "@shadow-library/class-schema": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "24.9.2",
    "light-my-request": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@shadow-library/app": "workspace:*",
    "@shadow-library/class-schema": "workspace:*",
    "@shadow-library/common": "workspace:*",
    "@shadow-library/fastify": "workspace:*"
  }
}
