{
  "name": "@shadow-library/common",
  "private": true,
  "type": "module",
  "version": "2.0.0-alpha.5",
  "description": "Essential TypeScript utilities for task management, HTTP clients, caching, logging, configuration, and error handling in the Shadow Library ecosystem",
  "sideEffects": [
    "**/index.js",
    "**/reflector.service.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "default": "./dist/interfaces/index.js"
    },
    "./cache": {
      "types": "./dist/services/cache/index.d.ts",
      "default": "./dist/services/cache/index.js"
    },
    "./config": {
      "types": "./dist/services/config.service.d.ts",
      "default": "./dist/services/config.service.js"
    },
    "./logger": {
      "types": "./dist/services/logger/index.d.ts",
      "default": "./dist/services/logger/index.js"
    },
    "./http": {
      "types": "./dist/classes/api-request.d.ts",
      "default": "./dist/classes/api-request.js"
    },
    "./reflect": {
      "types": "./dist/services/reflector.service.d.ts",
      "default": "./dist/services/reflector.service.js"
    }
  },
  "scripts": {},
  "engines": {
    "node": ">=23.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/common.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shadow-library/common/issues"
  },
  "homepage": "https://github.com/shadow-library/common#readme",
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/fast-redact": "^3.0.4",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "chokidar": "^5.0.0",
    "deepmerge": "^4.3.1",
    "fast-redact": "^3.5.0",
    "type-fest": "catalog:",
    "undici": "7.10.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  }
}
