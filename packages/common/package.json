    "url": "https://github.com/shadow-library/common/issues"
  },
  "homepage": "https://github.com/shadow-library/common#readme",
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/fast-redact": "^3.0.4",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "chokidar": "^5.0.0",
    "deepmerge": "^4.3.1",
    "fast-redact": "^3.5.0",
    "type-fest": "catalog:",
