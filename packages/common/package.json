    "test": "bun test",
    "build": "bun ../../scripts/src/bin/shadow.ts build"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/common.git"
