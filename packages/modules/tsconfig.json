{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ES2022",
    "moduleResolution": "node",
    "paths": {
      "@lib/*": ["src/*"],
      "@shadow-library/modules": ["src/index.ts"],
      "@shadow-library/modules/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
