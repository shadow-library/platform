{
  "extends": "./tsconfig.json",
  "tsc-alias": { "resolveFullPaths": true },
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "removeComments": true,
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
