{
  "name": "@shadow-library/web",
  "private": true,
  "version": "0.2.2-alpha.0",
  "type": "module",
  "description": "Frontend application framework for the Shadow Apps ecosystem — the typed API transport, TanStack Router/Query wiring, SSR session plumbing, and the Bun production server that every Shadow web app shares.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "default": "./dist/router/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server-entry": {
      "types": "./dist/server-entry.d.ts",
      "default": "./dist/server-entry.js"
    },
    "./pwa": {
      "types": "./dist/pwa/index.d.ts",
      "default": "./dist/pwa/index.js"
    },
    "./service-worker": {
      "types": "./dist/service-worker/index.d.ts",
      "default": "./dist/service-worker/index.js"
    },
    "./offline": {
      "types": "./dist/offline/index.d.ts",
      "default": "./dist/offline/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "verify": "bun ../../scripts/src/bin/shadow.ts verify",
    "type-check": "tsc",
    "test": "bun test",
    "build": "bun ../../scripts/src/bin/shadow.ts build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/web.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shadow-library/web/issues"
  },
  "homepage": "https://github.com/shadow-library/web#readme",
  "peerDependencies": {
    "@shadow-library/common": "workspace:*",
    "@tanstack/react-query": "^5.100.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-router-ssr-query": "^1.167.0",
    "@tanstack/react-start": "^1.168.0",
    "react": "^18.3.0 || ^19.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependenciesMeta": {
    "@shadow-library/common": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/react-router-ssr-query": {
      "optional": true
    },
    "@tanstack/react-start": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-ssr-query": "catalog:",
    "@tanstack/react-start": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:"
  },
  "dependencies": {
    "@shadow-library/common": "workspace:*",
    "@tanstack/history": "1.162.0",
    "@tanstack/router-core": "1.171.14"
  }
}
