{
  "name": "@shadow-library/app",
  "private": true,
  "type": "module",
  "version": "2.0.0-alpha.0",
  "sideEffects": false,
  "description": " A progressive Node.js framework for building efficient, scalable, and enterprise-grade applications using SOLID principles ",
  "scripts": {
    "clean": "rm -rf dist logs CHANGELOG.md",
    "type-check": "tsc",
    "build": "bun ../../scripts/src/bin/shadow.ts build",
    "verify": "bun ../../scripts/src/bin/shadow.ts verify",
    "test": "bun run test:unit && bun run test:integration",
    "test:unit": "bun test tests/decorators tests/injector tests/utils tests/injection-token.spec.ts tests/shadow-application.spec.ts tests/shadow-factory.spec.ts --coverage",
    "test:integration": "bun test tests/integration"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/app.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shadow-library/app/issues"
  },
  "homepage": "https://github.com/shadow-library/app#readme",
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@shadow-library/common": "workspace:*",
    "@types/bun": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@shadow-library/common": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "deepmerge": "^4.3.1",
    "type-fest": "catalog:"
  }
}
