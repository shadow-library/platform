{
  "name": "@shadow-library/fastify",
  "private": true,
  "type": "module",
  "version": "2.0.0-alpha.2",
  "sideEffects": [
    "src/config.ts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "A Fastify wrapper featuring decorator-based routing, middleware and error handling",
  "scripts": {
    "clean": "rm -rf dist logs CHANGELOG.md",
    "type-check": "tsc",
    "build": "bun ../../scripts/src/bin/shadow.ts build",
    "verify": "bun ../../scripts/src/bin/shadow.ts verify",
    "test": "bun test --isolate"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/fastify.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shadow-library/fastify/issues"
  },
  "homepage": "https://github.com/shadow-library/fastify#readme",
  "dependencies": {
    "@fastify/middie": "^9.0.3",
    "@shadow-library/app": "workspace:*",
    "@shadow-library/class-schema": "workspace:*",
    "@shadow-library/common": "workspace:*",
    "ajv": "catalog:",
    "fastify": "catalog:",
    "find-my-way": "^9.3.0",
    "json-stable-stringify": "^1.3.0",
    "light-my-request": "catalog:",
    "type-fest": "catalog:",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/view": "^10.0.2",
    "@types/bun": "catalog:",
    "reflect-metadata": "catalog:",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/view": "^10.0.0",
    "@shadow-library/app": "workspace:*",
    "@shadow-library/class-schema": "workspace:*",
    "@shadow-library/common": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependenciesMeta": {
    "@fastify/cookie": {
      "optional": true
    },
    "@fastify/view": {
      "optional": true
    }
  }
}
