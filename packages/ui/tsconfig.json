{
  "extends": "../../tsconfig.base.json",
  "include": ["src", ".storybook/**/*"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /** Kept from this package's own original config -- the base doesn't set these. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    /** Not a new opt-in: this package never set strictPropertyInitialization itself, so under its old
     *  standalone config "strict: true" alone made it effectively true. The base sets it false, so
     *  this override cancels that out to preserve the package's original effective behavior. */
    "strictPropertyInitialization": true,
    // Preserves prior behavior: this package doesn't opt into verbatimModuleSyntax (which implies
    // isolatedModules) the way the other web workspaces do, so isolatedModules stays off here too.
    "isolatedModules": false,

    "paths": {
      "@/*": ["./src/*"],
      "$storybook/*": ["./.storybook/*"]
    },
    "types": ["vite/client", "vitest/globals", "storybook/test", "@testing-library/jest-dom"]
  }
}
