{
  "extends": "../../tsconfig.base.json",
  "include": ["src", ".storybook/**/*"],
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    /** Extra strictness this package opts into beyond the base. */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "strictPropertyInitialization": true,
    // Preserves prior behavior: this package doesn't opt into verbatimModuleSyntax (which implies
    // isolatedModules) the way the other web workspaces do, so isolatedModules stays off here too.
    "isolatedModules": false,

    "paths": {
      "@/*": ["./src/*"],
      "$storybook/*": ["./.storybook/*"]
    },
    "types": ["vite/client", "vitest/globals", "storybook/test", "@testing-library/jest-dom"]
  }
}
