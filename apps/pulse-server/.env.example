# Runtime
NODE_ENV=development
APP_STAGE=dev                           # dev | staging | prod (defaults to prod when unset)

# Datastore (owned by @shadow-library/modules DatabaseModule)
DATABASE_POSTGRES_URL=postgresql://postgres:postgres@localhost:7070/shadow_pulse
DATABASE_POSTGRES_LAZY_CONNECTION=true
DATABASE_POSTGRES_MAX_CONNECTIONS=10

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# Set true behind the ingress so request.ip resolves from the x-forwarded-for chain the SSR web pods
# forward from the browser. Leave false out of cluster — an unfiltered header would forge client IPs.
APP_TRUST_PROXY=false

# Resend email delivery (required only when an EMAIL sender endpoint uses provider RESEND)
RESEND_API_KEY=
