{
  "name": "@shadow-library/pulse-server",
  "type": "module",
  "version": "0.0.0",
  "description": "A notification service for Shadow applications",
  "scripts": {
    "prepare": "shadow prepare",
    "clean": "rm -rf dist logs CHANGELOG.md",
    "verify": "shadow verify",
    "type-check": "bun run tsc",
    "test": "bun test",
    "build": "shadow build",
    "dev": "bun run --watch src/main.ts",
    "db:create-template": "bun run scripts/create-template-db.ts",
    "db:migrate": "bun run scripts/migrate-db.ts",
    "db:seed": "bun run scripts/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/pulse.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shadow-library/pulse/issues"
  },
  "homepage": "https://github.com/shadow-library/pulse#readme",
  "devDependencies": {
    "@shadow-library/scripts": "0.3.0",
    "@types/bun": "^1.3.1",
    "@types/validator": "^13.15.10",
    "drizzle-kit": "^0.31.7",
    "husky": "^9.1.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@shadow-library/app": "2.0.0-alpha.0",
    "@shadow-library/auth": "0.4.0-alpha.1",
    "@shadow-library/class-schema": "0.5.0-alpha.0",
    "@shadow-library/common": "2.0.0-alpha.4",
    "@shadow-library/fastify": "2.0.0-alpha.0",
    "@shadow-library/modules": "0.7.0-alpha.0",
    "drizzle-orm": "^0.44.7",
    "juice": "^12.1.1",
    "libphonenumber-js": "^1.12.33",
    "liquidjs": "^10.27.2",
    "reflect-metadata": "^0.2.2",
    "validator": "^13.15.26"
  }
}
