{
  "name": "@shadow-library/pulse-server",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "A notification service for Shadow applications",
  "scripts": {
    "clean": "rm -rf dist logs CHANGELOG.md",
    "type-check": "bun run tsc",
    "test": "bun test",
    "dev": "bun run --watch src/main.ts",
    "db:create-template": "bun run scripts/create-template-db.ts",
    "db:migrate": "bun run scripts/migrate-db.ts",
    "db:seed": "bun run scripts/seed.ts"
  },
  "shadow": {
    "entries": [
      "scripts/migrate-db.ts"
    ],
    "assets": [
      "generated/drizzle"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/pulse.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shadow-library/pulse/issues"
  },
  "homepage": "https://github.com/shadow-library/pulse#readme",
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/validator": "^13.15.10",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@shadow-library/app": "workspace:*",
    "@shadow-library/auth": "workspace:*",
    "@shadow-library/class-schema": "workspace:*",
    "@shadow-library/common": "workspace:*",
    "@shadow-library/fastify": "workspace:*",
    "@shadow-library/modules": "workspace:*",
    "drizzle-orm": "catalog:",
    "juice": "^12.1.1",
    "libphonenumber-js": "^1.12.33",
    "liquidjs": "^10.27.2",
    "reflect-metadata": "catalog:",
    "validator": "^13.15.26"
  }
}
