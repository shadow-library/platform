# Runtime
NODE_ENV=development
APP_STAGE=dev                           # dev | staging | prod (defaults to prod when unset)

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Datastore (owned by @shadow-library/modules DatabaseModule). Run `bun scripts/db.ts apps/synapse-server migrate` after setting.
DATABASE_POSTGRES_URL=postgresql://postgres:postgres@localhost:7070/synapse
DATABASE_POSTGRES_LAZY_CONNECTION=true
DATABASE_POSTGRES_MAX_CONNECTIONS=10

# Identity (owned by @shadow-library/auth). Audience, redirect URIs and scopes are derived from
# GET {issuer}/api/v1/apps/me at boot — never restated here.
AUTH_ISSUER=https://identity.shadow-apps.com
AUTH_APP_ID=synapse

# The application's M2M credential. Without one the service boots offline: no browser flow, and every
# M2M caller is denied because service-access rules cannot load.
# AUTH_CLIENT_SECRET=
# AUTH_CLIENT_ASSERTION_PATH=/var/run/secrets/tokens/synapse

# Catalog cache and request handling
SYNAPSE_CATALOG_POLL_MS=5000
SYNAPSE_REQUEST_TIMEOUT_MS=300000
SYNAPSE_SERVER_KEEP_ALIVE_TIMEOUT_MS=5000
SYNAPSE_SERVER_MAX_REQUESTS_PER_SOCKET=50
SYNAPSE_SHUTDOWN_GRACE_MS=30000

# Catalog v1 seed applied by the migrate entrypoint: standard | local-only (local-only routes every model to Ollama, so e2e makes no paid calls)
SYNAPSE_SEED_PROFILE=standard

# Provider credentials keyring: comma-separated `<kid>:<base64url 32 bytes>`, the first entry sealing new secrets and every entry
# opening them. Required in production; outside it a public dev-only keyring is the default. Rotate by adding a key, never by replacing one.
# SYNAPSE_CRYPTO_KEYS=k1:<base64url 32 bytes>

# Providers
SYNAPSE_PROVIDER_SUBSCRIPTION_URL=http://host.docker.internal:7431/v1
SYNAPSE_PROVIDER_OPENROUTER_URL=https://openrouter.ai/api/v1
# Import source only, for one release: the migrate hook stores it as the `openrouter` credential once, then manage it in synapse-web
# SYNAPSE_PROVIDER_OPENROUTER_API_KEY=
SYNAPSE_PROVIDER_LOCAL_URL=http://host.docker.internal:11434

# Usage ledger
SYNAPSE_LEDGER_RETENTION_DAYS=400
