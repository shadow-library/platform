# Runtime
NODE_ENV=development
APP_STAGE=dev                           # dev | staging | prod (defaults to prod when unset)

# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database — PostgreSQL 16+ (pgvector image, per platform convention). Run
# `bun scripts/db.ts apps/shadow-memoir-server migrate` after setting.
DATABASE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/shadow_memoir
DATABASE_POSTGRES_LAZY_CONNECTION=true
DATABASE_POSTGRES_MAX_CONNECTIONS=10

# Identity (owned by @shadow-library/auth, §3.4/§3.5). Steady state is three settings: the issuer this
# service trusts, this application's id at identity (also its OAuth client id, `shadow-memoir`), and one
# credential. Audience, redirect URIs and scopes are derived from GET {issuer}/api/v1/apps/me at boot —
# never restated here.
AUTH_ISSUER=https://identity.shadow-apps.com
AUTH_APP_ID=shadow-memoir

# The application's M2M credential. Setting it turns on the first-party browser login flow
# (/api/auth/login|callback|logout|session|step-up) and lets the service reach identity for
# service-access rules and app-session token minting. Leave unset in local development to boot offline
# (browser flow disabled, every M2M caller denied).
# AUTH_CLIENT_SECRET=
# AUTH_CLIENT_ASSERTION_PATH=/var/run/secrets/tokens/shadow-memoir

# How long a resolved sub -> account mapping stays LRU-cached (§8.3 AccountContext).
ACCOUNT_CONTEXT_TTL=60

# Scheduler (§8.1, ADR-0002) — the in-process tick loop; disable on the API replica once a
# separately deployed worker (src/worker.ts) takes over.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_INTERVAL_MS=5000

# Rollover (§13.3) — bounds the per-account day-close catch-up walk; tunable without redeploy.
ROLLOVER_CATCHUP_MAX_DAYS=90

# Quotas/caps (§22) — tunable without redeploy.
QUOTAS_OCR_DAILY=5
QUOTAS_AI_FREE_MONTHLY=2
QUOTAS_AI_PAID_DAILY=30
QUOTAS_ENTRY_DAILY_CAP=200
QUOTAS_RESCHEDULE_CAP=3

# AI batch executor (Phase 2, §15) — stub values until T-32/T-33 wire the module.
AI_BATCH_WINDOW=02:00
AI_MODEL=llama3.1
AI_PROMPT_VERSION=v1
AI_TASK_TIMEOUT_MINUTES=30

# Receipt storage (§19) — bucket provisioned per env by the T-04 operator checklist.
STORAGE_RECEIPTS_BUCKET=memoir-receipts

# Billing (§16) — stub values until T-31 wires the provider adapter.
BILLING_PROVIDER=stripe
BILLING_WEBHOOK_TOLERANCE_SECONDS=300

# FX capture/reconciliation (§14.1) — stub values until T-25 wires finance core.
FX_PROVIDER_URL=https://api.exchangerate.host
FX_RECONCILIATION_INTERVAL_MINUTES=60

# Telemetry pseudo-id HMAC key (§23) — ops-provisioned per env (SOPS); the default is dev/test-only and
# must never be reused in a real environment, since it is what keeps an analytics pseudo-id irreversible.
# TELEMETRY_PSEUDO_ID_SECRET=
