
# Backend origin the SSR transport reaches directly, skipping the ingress — novel-forge-server's in-cluster
# Service DNS at deploy time (e.g. http://novel-forge-server.<namespace>.svc.cluster.local:8080). The browser
# never needs this: it calls the same-origin /api/* the ingress routes. Leave it unset in development; the
# transport falls back to http://localhost:8080.
API_ORIGIN=

# Domain the shared light/dark theme cookie is written for. Set it to the registrable parent domain the
# platform's apps live under (e.g. .shadow-apps.com) so a theme picked in one app is the theme every other
# app opens with. Leave it unset in development: the local apps differ only by port, which a cookie's scope
# already ignores.
VITE_THEME_COOKIE_DOMAIN=

# Origin that serves object-storage bytes anonymously. Covers and portraits are stored content-addressed
# by novel-forge-server and served from the platform's public bucket (Garage's website endpoint), so the
# browser builds `<origin>/<ref>` directly. Set it to the deploy's storage origin (e.g.
# https://storage.shadow-apps.com). Left unset, it falls back to the local dev default.
VITE_STORAGE_PUBLIC_ORIGIN=
