# Canonical deploy-time origin of the identity server — its in-cluster Service DNS name. The SSR transport
# (src/lib/apis/transport.ts) reads this first; leave it unset in development, where SERVER_URL below already
# names the right origin.
API_ORIGIN=

# Base URL of the identity server. TanStack Start server functions call it directly (server-side), the
# dev/preview proxy forwards the browser-facing /oauth2 and /saml2 redirect endpoints to it, and the SSR
# transport falls back to it whenever API_ORIGIN is unset.
SERVER_URL=http://localhost:8080

# OpenAPI spec used by `bun run generate:api-types` to regenerate src/lib/apis/api-types.gen.ts.
OPENAPI_SPEC_URL=http://localhost:8080/dev/api-docs/openapi.json

# Domain the shared light/dark theme cookie is written for. Set it to the registrable parent domain the
# platform's apps live under (e.g. .shadow-apps.com) so a theme picked in one app is the theme every other
# app opens with. Leave it unset in development: the local apps differ only by port, which a cookie's scope
# already ignores.
VITE_THEME_COOKIE_DOMAIN=
