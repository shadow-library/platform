{
  "name": "webnovel-web",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "shadow prepare",
    "dev": "vite dev --port 3000",
    "build": "shadow build",
    "build:app": "bun run scripts/generate-manifest.ts && vite build && vite build --config vite.sw.config.ts && bun run format:gen",
    "format:gen": "prettier --log-level warn --single-quote --trailing-comma all --print-width 180 --arrow-parens avoid --write src/routeTree.gen.ts",
    "start": "bun main.ts",
    "verify": "shadow verify",
    "type-check": "tsc",
    "test": "vitest run",
    "generate:api-types": "shadow gen-api-types http://localhost:8080/dev/api-docs/openapi.json --out src/lib/apis/api-types.gen.ts"
  },
  "dependencies": {
    "@shadow-library/ui": "3.3.0-alpha.2",
    "@shadow-library/web": "^0.2.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.27",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@shadow-library/scripts": "0.3.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.9",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
