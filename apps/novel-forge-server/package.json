{
  "name": "@shadow-library/novel-forge-server",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Backend service for the AI-powered novel generation platform. Provides workflow orchestration, lore management, chapter generation, AI integrations, user review pipelines, and continuity validation.",
  "scripts": {
    "clean": "rm -rf dist logs CHANGELOG.md",
    "type-check": "tsc -p tsconfig.json",
    "test": "bun test",
    "dev": "bun run --watch src/main.ts",
    "db:create-template": "bun ../../scripts/db.ts apps/novel-forge-server create-template",
    "db:migrate": "bun ../../scripts/db.ts apps/novel-forge-server migrate",
    "db:generate": "bun ../../scripts/db.ts apps/novel-forge-server generate",
    "db:seed": "bun ../../scripts/db.ts apps/novel-forge-server seed",
    "ai:smoke": "bun run scripts/ai-smoke.ts",
    "ai:pull-models": "bun run scripts/ai-pull-models.ts",
    "test:ai:local": "bun test tests/ai/local/",
    "test:ai:unit": "bun test tests/ai/prompts.spec.ts tests/ai/model-router.spec.ts tests/ai/context-assembler.spec.ts",
    "test:ai:graph": "bun test tests/ai/workflow.spec.ts",
    "test:ai:tools": "bun test tests/ai/tool-registry.spec.ts"
  },
  "shadow": {
    "entries": [
      "src/migrate.ts"
    ],
    "assets": [
      "generated/drizzle"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/novel-forge-server.git"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shadow-library/novel-forge-server/issues"
  },
  "homepage": "https://github.com/shadow-library/novel-forge-server#readme",
  "devDependencies": {
    "@types/bun": "catalog:",
    "drizzle-kit": "catalog:",
    "fastify": "catalog:",
    "type-fest": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.3",
    "@langchain/xai": "^1.4.3",
    "@llamaindex/postgres": "^0.0.66",
    "@shadow-library/app": "workspace:*",
    "@shadow-library/auth": "workspace:*",
    "@shadow-library/class-schema": "workspace:*",
    "@shadow-library/common": "workspace:*",
    "@shadow-library/fastify": "workspace:*",
    "@shadow-library/modules": "workspace:*",
    "ajv": "catalog:",
    "drizzle-orm": "catalog:",
    "fflate": "^0.8.3",
    "js-tiktoken": "^1.0.12",
    "langchain": "^0.3.29",
    "llamaindex": "^0.9.4",
    "ollama": "^0.6.3",
    "reflect-metadata": "catalog:",
    "zod": "^3.25.76"
  }
}
