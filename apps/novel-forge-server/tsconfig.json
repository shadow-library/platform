{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ES2022",
    "paths": {
      "@server/*": ["./src/*"],
      "@modules/*": ["./src/modules/*"],
      "@scripts/*": ["./scripts/*"],
      "@tests/*": ["./tests/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "drizzle.config.ts"]
}
