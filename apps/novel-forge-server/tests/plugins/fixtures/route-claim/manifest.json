{
  "id": "route-claim",
  "version": "1.0.0",
  "title": "Route Claim",
  "description": "Fixture plugin that claims the routing decision point exclusively and rejects a config no form can refuse.",
  "decisionPoints": ["call.route"],
  "exclusive": ["call.route"],
  "forms": {
    "settings": {
      "fields": [
        { "name": "threshold", "type": "number", "title": "Threshold" },
        { "name": "mode", "type": "string", "title": "Mode", "widget": "select", "enum": ["wide", "narrow"] }
      ],
      "required": ["threshold"]
    }
  }
}
