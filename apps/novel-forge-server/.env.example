# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_STAGE=dev                           # dev | staging | prod (defaults to prod when unset)

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
# Set true behind the ingress so request.ip resolves from the x-forwarded-for chain the SSR web pods
# forward from the browser. Leave false out of cluster — an unfiltered header would forge client IPs.
APP_TRUST_PROXY=false

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16+ with pgvector extension. Run `bun run db:migrate` after setting.
DATABASE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/novel_forge

# ─── AI profile ───────────────────────────────────────────────────────────────
# production  → Grok via OpenRouter for all LLM roles (requires AI_OPENROUTER_API_KEY)
# local-test  → Ollama for all roles (requires a running Ollama server)
AI_PROFILE=production

# ─── API keys ─────────────────────────────────────────────────────────────────
# Every hosted chat model (Anthropic, OpenAI, xAI) is reached through OpenRouter, so the production
# profile needs this one key. Point the URL at an in-cluster gateway to redirect the whole leg.
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_API_URL=https://openrouter.ai/api/v1

# Image generation calls the vendors directly and needs its own credentials.
AI_XAI_IMAGE_API_KEY=
AI_OPENAI_IMAGE_API_KEY=

# ─── Grok models ──────────────────────────────────────────────────────────────
AI_GROK_LLM_MODEL=x-ai/grok-3
AI_GROK_IMAGE_MODEL=grok-2-image

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Required when AI_PROFILE=local-test or any role routes to ollama.
# Run `bun run ai:pull-models` to pull the pinned test models.
AI_OLLAMA_HOST=http://localhost:11434
AI_EMBEDDING_MODEL=qwen3-embedding:8b

# ─── Subprocess providers (optional, local-dev only) ─────────────────────────
# ai.claude-code.* — enables the `claude` CLI as an LLM backend
AI_CLAUDE_CODE_ENABLED=false
AI_CLAUDE_CODE_BIN=claude

# ai.codex.* — enables the `codex` CLI as an LLM backend
AI_CODEX_ENABLED=false
AI_CODEX_BIN=codex

# ─── Observability ────────────────────────────────────────────────────────────
# Set AI_LANGSMITH_API_KEY to enable LangSmith tracing (optional).
AI_LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ─── Storage ──────────────────────────────────────────────────────────────────
# Shared object storage lives in @shadow-library/modules' StorageModule. Refs are content-addressed
# (`<sha256hex>.<ext>`); images resolve to anonymous public URLs at STORAGE_PUBLIC_ORIGIN/<ref>.
STORAGE_DRIVER=s3                       # s3 (Garage) | local (disk, for dev without a cluster)
STORAGE_PUBLIC_ORIGIN=https://storage.shadow-apps.test   # public download origin (Garage website endpoint)

# s3 driver (Garage). External endpoint signs presigned upload URLs reachable from outside the cluster.
STORAGE_S3_ENDPOINT=http://garage.system.svc:3900
STORAGE_S3_EXTERNAL_ENDPOINT=https://storage-api.shadow-apps.test
STORAGE_S3_REGION=garage
STORAGE_S3_BUCKET=storage
STORAGE_S3_ACCESS_KEY_ID=               # required in prod
STORAGE_S3_SECRET_ACCESS_KEY=           # required in prod

# local driver (STORAGE_DRIVER=local): where objects are written on disk
STORAGE_LOCAL_DIR=./storage-data

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug                         # silly | debug | http | info | warn | error

# ─── Identity / auth ──────────────────────────────────────────────────────────
# Every /api/v1 route requires a bearer token issued by the shadow identity
# service; browsers authenticate through the first-party session surface the
# @shadow-library/auth SDK mounts (/api/auth/login → /api/auth/callback →
# opaque __Host-shadow-session cookie → /api/auth/session).
#
# A steady-state deploy configures three things: the issuer, this application's
# id at identity, and one client credential. Audience (api://novel-forge),
# redirect URIs and granted scopes are discovered from identity's
# GET /api/v1/apps/me, so they are never restated here.
AUTH_ISSUER=https://identity.shadow-apps.com
# This application's id at identity (also its OAuth client id).
AUTH_APP_ID=novel-forge
# The client credential — required to boot: the SDK reads this app's registration
# back from identity with it. In-cluster prefer a projected service-account token
# via AUTH_CLIENT_ASSERTION_PATH; outside it, a static AUTH_CLIENT_SECRET.
AUTH_CLIENT_SECRET=
# AUTH_CLIENT_ASSERTION_PATH=/var/run/secrets/shadow/identity-token
# Reader (web-novel) service base URL override; defaults to the in-cluster
# http://web-novel-server. The same AUTH_* credential mints its publish tokens
# (audience api://web-novel, scope web-novel:publish).
# SERVICE_URL_WEB_NOVEL_SERVER=https://web-novel.shadow-apps.com
# Whether a publish/unpublish immediately dispatches a reader push (true) or waits
# for the scheduled janitor sweep (false). Defaults to true.
# PUBLISHING_AUTO_PUSH=true
# Finalized chapters within an arc between automatic re-outlines of that arc's
# remaining chapters. A stale remaining brief re-outlines immediately regardless.
# GENERATION_RECONCILIATION_CADENCE=5
