# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_STAGE=dev                         # dev | staging | prod

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16+ with pgvector extension. Run `bun run db:migrate` after setting.
DATABASE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/novel_forge

# ─── AI Profile ───────────────────────────────────────────────────────────────
# production  → xAI Grok for all LLM/image roles (requires AI_XAI_API_KEY)
# local-test  → Ollama for all roles (requires a running Ollama server)
AI_PROFILE=production

# ─── API Keys ─────────────────────────────────────────────────────────────────
# Required keys depend on AI_PROFILE and per-project model config.
# production profile defaults to xAI — set AI_XAI_API_KEY at minimum.
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_XAI_API_KEY=

# ─── xAI / Grok models ────────────────────────────────────────────────────────
AI_GROK_LLM_MODEL=grok-3             # LLM model for standard and grok_only projects
AI_GROK_IMAGE_MODEL=grok-2-image     # Image model for grok_only projects

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Required when AI_PROFILE=local-test or when any role routes to ollama.
# Run `bun run ai:pull-models` to pull the pinned test models.
AI_OLLAMA_HOST=http://localhost:11434
AI_EMBEDDING_MODEL=qwen3-embedding:8b

# ─── Subprocess providers (optional, local-dev only) ─────────────────────────
# Set AI_ALLOW_CLAUDE_CODE=true to enable routing roles to the `claude` CLI.
# Set AI_ALLOW_CODEX=true to enable routing roles to the `codex` CLI.
AI_ALLOW_CLAUDE_CODE=false
AI_ALLOW_CODEX=false
AI_CLAUDE_CODE_BIN=claude
AI_CODEX_BIN=codex

# ─── Observability ────────────────────────────────────────────────────────────
# Set to enable LangSmith tracing. Leave blank to disable.
AI_LANGSMITH_API_KEY=
LANGSMITH_TRACING=false               # Set true to activate LangSmith SDK tracing

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local                  # local only (cloud provider swappable via DI)
STORAGE_IMAGE_DIR=./images            # Directory for illustration images

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug                       # silly | debug | http | info | warn | error
