# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_STAGE=dev                           # dev | staging | prod

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL 16+ with pgvector extension. Run `bun run db:migrate` after setting.
DATABASE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/novel_forge

# ─── AI profile ───────────────────────────────────────────────────────────────
# production  → xAI Grok for all LLM/image roles (requires AI_XAI_API_KEY)
# local-test  → Ollama for all roles (requires a running Ollama server)
AI_PROFILE=production

# ─── API keys ─────────────────────────────────────────────────────────────────
# Set the key(s) for the provider(s) you intend to use.
# The production profile defaults to xAI — AI_XAI_API_KEY is required at minimum.
AI_ANTHROPIC_API_KEY=
AI_OPENAI_API_KEY=
AI_XAI_API_KEY=

# ─── Grok models ──────────────────────────────────────────────────────────────
AI_GROK_LLM_MODEL=grok-3
AI_GROK_IMAGE_MODEL=grok-2-image

# ─── Ollama ───────────────────────────────────────────────────────────────────
# Required when AI_PROFILE=local-test or any role routes to ollama.
# Run `bun run ai:pull-models` to pull the pinned test models.
AI_OLLAMA_HOST=http://localhost:11434
AI_EMBEDDING_MODEL=qwen3-embedding:8b

# ─── Subprocess providers (optional, local-dev only) ─────────────────────────
# ai.claude-code.* — enables the `claude` CLI as an LLM backend
AI_CLAUDE_CODE_ENABLED=false
AI_CLAUDE_CODE_BIN=claude

# ai.codex.* — enables the `codex` CLI as an LLM backend
AI_CODEX_ENABLED=false
AI_CODEX_BIN=codex

# ─── Observability ────────────────────────────────────────────────────────────
# Set AI_LANGSMITH_API_KEY to enable LangSmith tracing (optional).
AI_LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local                    # local only (swap to s3 via one DI change)
STORAGE_LOCAL_DIR=./images             # storage.local.* — local image directory

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=debug                         # silly | debug | http | info | warn | error
