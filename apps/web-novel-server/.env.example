# Runtime
NODE_ENV=development

# Datastore (owned by @shadow-library/modules DatabaseModule)
DATABASE_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/shadow_webnovel
DATABASE_POSTGRES_LAZY_CONNECTION=true
DATABASE_POSTGRES_MAX_CONNECTIONS=10

# Identity (owned by @shadow-library/auth). Steady state is three settings: the issuer this
# service trusts, this application's id at identity (also its OAuth client id), and one credential.
# Audience, redirect URIs and scopes are derived from GET {issuer}/api/v1/apps/me at boot — never
# restated here.
AUTH_ISSUER=https://identity.shadow-apps.com
AUTH_APP_ID=web-novel

# The application's M2M credential. Setting it turns on the first-party browser login flow
# (/api/auth/login|callback|logout|session|step-up) and lets the service reach identity for
# service-access rules and app-session token minting. Leave unset in local development to boot
# offline (browser flow disabled, every M2M caller denied).
# AUTH_CLIENT_SECRET=

# Plain-HTTP local development only: the session cookie defaults to the Secure, __Host--prefixed
# `__Host-shadow-session`, which a browser refuses over http. Uncomment BOTH to drop the prefix.
# AUTH_SESSION_COOKIE_SECURE=false
# AUTH_SESSION_COOKIE_NAME=shadow-session

# Server
PORT=8080
