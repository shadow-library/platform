{
  "name": "@shadow-library/web-novel-server",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Public webnovel reader service: serves published novels pushed one-way from novel-forge-server",
  "scripts": {
    "prepare": "shadow prepare",
    "clean": "rm -rf dist logs CHANGELOG.md",
    "verify": "shadow verify",
    "type-check": "bun run tsc",
    "test": "bun test",
    "build": "shadow build",
    "dev": "bun run --watch src/main.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate-db.ts",
    "db:create-template": "bun run scripts/create-template-db.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/shadow-library/platform.git",
    "directory": "apps/web-novel-server"
  },
  "author": "Leander Paul <leanderpaul97@outlook.com>",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/shadow-library/platform/issues"
  },
  "homepage": "https://github.com/shadow-library/platform#readme",
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "drizzle-kit": "^0.31.6",
    "husky": "^9.1.7",
    "type-fest": "^4.41.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@shadow-library/app": "workspace:*",
    "@shadow-library/auth": "workspace:*",
    "@shadow-library/class-schema": "workspace:*",
    "@shadow-library/common": "workspace:*",
    "@shadow-library/fastify": "workspace:*",
    "@shadow-library/modules": "workspace:*",
    "ajv": "^8.17.1",
    "drizzle-orm": "^0.45.0",
    "reflect-metadata": "^0.2.2"
  }
}
