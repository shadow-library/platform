{
  "type": "backend",
  "build": {
    "entry": "src/main.ts",
    "assets": ["generated/drizzle"]
  },
  "verify": {
    "files": "{src,tests,scripts}/**/*.ts",
    "lint": {
      "globals": "node",
      "rules": {
        "@typescript-eslint/no-namespace": "off"
      }
    }
  },
  "checkMigrations": {
    "dir": "generated/drizzle"
  }
}
