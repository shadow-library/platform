# Runtime
NODE_ENV=development
APP_STAGE=dev                           # dev | staging | prod (defaults to prod when unset)

# Datastore (owned by @shadow-library/modules DatabaseModule)
DATABASE_POSTGRES_URL=postgresql://postgres:postgres@localhost:7070/shadow_identity
DATABASE_REDIS_URL=redis://localhost:7080
DATABASE_POSTGRES_LAZY_CONNECTION=true
DATABASE_POSTGRES_MAX_CONNECTIONS=10

# Security — required in production; a default is used only in development
SECURITY_MASTER_ENCRYPTION_KEY=

# Platform bootstrap admin — if the password is empty a strong one is generated
# and logged once on first boot
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@shadow-apps.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=

# Password policy — enable the Have I Been Pwned breach check in production
AUTH_PASSWORD_BREACH_CHECK_ENABLED=false

# Rate limiting — kill switch and infrastructure IP bypass (comma separated). The limiter keys on
# request.ip; until APP_TRUST_PROXY is enabled here and x-forwarded-for is set at the ingress, every
# in-cluster SSR pod shares one rate-limit identity by its pod IP, so allowlist those IPs to keep
# server-rendered traffic from throttling itself.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_IP_ALLOWLIST=

# WebAuthn relying party
AUTH_WEBAUTHN_RP_ID=localhost
AUTH_WEBAUTHN_ORIGIN=http://localhost:8080

# Notifications go to pulse-server via svc:// service discovery (no base URL config). In-cluster it
# resolves to `http://pulse-server`; locally point it at your pulse dev server:
SERVICE_URL_PULSE_SERVER=http://localhost:3000

# OAuth / OIDC issuer identity
OAUTH_ISSUER=https://identity.shadow-apps.com
OAUTH_LOGIN_URL=https://identity.shadow-apps.com/login

# Kubernetes workload identity — trusted cluster OIDC issuer for SA-token client assertions.
# Leave the issuer empty to disable assertion-based client authentication entirely. Callers must
# project a token dedicated to identity (`serviceAccountToken` volume with
# `audience: <OAUTH_ISSUER>`) — the accepted assertion audience is pinned to OAUTH_ISSUER and is
# not configurable, so the API-server token every pod already carries can never authenticate.
# The JWKS URI is normally resolved from the cluster's OIDC discovery document; override to skip it.
AUTH_WORKLOAD_ISSUER=
AUTH_WORKLOAD_JWKS_URI=
AUTH_WORKLOAD_SA_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token

# Worker
WORKER_POLL_INTERVAL=5000

# Server
SERVER_PORT=8080
# Set true behind the ingress so request.ip resolves from the x-forwarded-for chain the SSR web pods
# forward from the browser — this is what makes the rate limiter above key on the real client IP.
# Leave false out of cluster — an unfiltered header would forge client IPs.
APP_TRUST_PROXY=false
