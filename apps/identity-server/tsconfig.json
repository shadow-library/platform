{
  "extends": "../tsconfig.server.json",
  /**
   * `paths` is intentionally not inherited from `tsconfig.server.json` — see that file's comment (Bun's
   * runtime resolver mis-resolves `${configDir}` across a two-level `extends` chain). Declared plainly
   * relative here, as every leaf before this restructuring did.
   */
  "compilerOptions": {
    "paths": {
      "@modules/*": ["./src/modules/*"],
      "@server/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    }
  }
}
