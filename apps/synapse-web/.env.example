
# Backend origin the SSR transport reaches directly, skipping the ingress — synapse-server's in-cluster
# Service DNS at deploy time (e.g. http://synapse-server.synapse). The browser never needs this: it calls the
# same-origin /api/* the ingress routes. Leave it unset in development; the transport falls back to
# http://localhost:8080.
API_ORIGIN=

# Domain the shared light/dark theme cookie is written for. Set it to the registrable parent domain the
# platform's apps live under (e.g. .shadow-apps.com) so a theme picked in one app is the theme every other
# app opens with. Leave it unset in development: the local apps differ only by port, which a cookie's scope
# already ignores.
VITE_THEME_COOKIE_DOMAIN=
