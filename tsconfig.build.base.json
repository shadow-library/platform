{
  /**
   * The shared build-emit shape every `packages/*` workspace's own `tsconfig.build.json` extends alongside its
   * own `tsconfig.json` (extends order matters: the workspace's own file must win for anything it overrides).
   * Centralizes what was previously six byte-identical per-workspace copies. `rootDir`/`include`/`exclude` stay
   * per-workspace: TS resolves path-valued fields inherited through `extends` relative to the file that
   * DECLARES them, not the file that extends it — a shared `include`/`rootDir` here would resolve against this
   * file's own directory (the repo root) for every consumer, not each workspace's `src/`.
   */
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "removeComments": true
  }
}
