{
  "name": "@shadow-library/platform",
  "private": true,
  "workspaces": ["apps/*", "packages/*", "e2e"],
  "scripts": {
    "prepare": "husky",
    "verify": "bun run --filter '*' verify",
    "verify:tooling": "bun scripts/scripts/verify.ts",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:tooling": "bun test scripts/tests",
    "commit-msg": "bun scripts/src/bin/shadow.ts commit-msg"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/format": "^21.2.0",
    "@commitlint/lint": "^21.2.0",
    "@commitlint/load": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/bun": "^1.3.14",
    "cssnano": "^8.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.19",
    "postcss-import": "^16.1.1",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "rollup-plugin-banner2": "^1.3.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-postcss": "^4.0.2",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
