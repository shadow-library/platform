# Dependencies — no trailing slash: in a git worktree `node_modules` is a symlink, which a
# directory-only pattern would not match, leaving it stageable.
node_modules

# Build output
dist/
coverage/
CHANGELOG.md

# Logs
logs/
*.log
npm-debug.log*

# Environment — never commit real env files
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# OS / editor
.DS_Store
.vscode/
.project
.settings/
.npmrc

# Claude worktrees
.claude/worktrees/

# Framework caches
.vite/
.output
.tanstack
.nitro
.wrangler

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/
# Scratch output (screenshots, snapshots) from the Playwright MCP server, not from the e2e suite
.playwright-mcp/

# Serena (do not commit)
.serena/

# graphify (do not commit — generated knowledge graphs, root and per-workspace)
graphify-out/

# Claude local overrides (do not commit)
CLAUDE.local.md

# Workspace-scoped ignores (hoisted from the deleted per-workspace .gitignore files)
apps/identity-server/public/
apps/identity-server/*.tgz
apps/novel-forge-server/images/
apps/novel-forge-web/stats.html
apps/novel-forge-web/count.txt
apps/pulse-web/dist-ssr
apps/pulse-web/*.local
apps/pulse-web/stats.html
apps/pulse-web/count.txt
apps/shadow-memoir-web/public/manifest.webmanifest
apps/web-novel-web/public/manifest.webmanifest
packages/ui/*storybook.log
packages/ui/storybook-static
scratch-pad/
.worktrees/
