{
  /**
   * `files` (unlike `include`/`exclude`/path-valued compilerOptions) resolves to an absolute path at the point it
   * is declared, so this reaches every workspace that extends this base regardless of its own directory depth —
   * the shared `bun:test` `Expect<T>` augmentation, formerly duplicated as 8 byte-identical `tests/test.d.ts` copies.
   */
  "files": ["types/bun-test.d.ts"],
  "compilerOptions": {
    /** Language and Environment */
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["ES2022"],
    "target": "ES2022",

    /** Type Checking */
    "alwaysStrict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,

    /** Modules */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["bun"],

    /** Emit */
    "noEmit": true,

    /** Interop Constraints */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    /** Completeness */
    "skipLibCheck": true
  }
}
