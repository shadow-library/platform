# Run the suite with `bun run test` (or `bunx playwright test`) from inside e2e/ — it needs a reachable
# deployment (or explicit "" opt-outs below). `bun scripts/verify.ts e2e` (from the repo root) only runs
# format/lint/type-check and never touches the network.
#
# Base URLs for the four products. Each already defaults to the local k3d dev ingress below when its var
# is unset, so a normal local checkout needs no `.env` at all. Three states per var:
#   unset               -> the .test default
#   set to "" (blank)   -> explicitly opted out for this run (skips, never falls back to the default)
#   set to anything else -> overrides the default
# Copy this file to `.env` only if you need to override one — e.g. to point at a deployed environment, or
# to opt a product out with `E2E_NOVEL_FORGE_URL=`.

# E2E_IDENTITY_URL=https://identity.shadow-apps.test
# E2E_MEMOIR_URL=https://shadow-memoir.shadow-apps.test
# E2E_NOVEL_FORGE_URL=https://novelforge.shadow-apps.test
# E2E_PULSE_URL=https://pulse.shadow-apps.test
# E2E_WEB_NOVEL_URL=https://webnovel.shadow-apps.test

# Override examples for a deployed (non-local) environment — confirm the real hostnames before use, these
# are illustrative:
# E2E_IDENTITY_URL=https://identity.shadow-apps.com
# E2E_MEMOIR_URL=https://<shadow-memoir-domain>
# E2E_NOVEL_FORGE_URL=https://<novel-forge-domain>
# E2E_PULSE_URL=https://pulse.shadow-apps.com
# E2E_WEB_NOVEL_URL=https://web-novel.shadow-apps.com

# Path to a Playwright storage-state JSON (https://playwright.dev/docs/auth) for authenticated flows. The
# `setup` project now produces per-persona states under `.auth/` (user1.json, user2.json, admin.json) — prefer
# `apiContext(product, persona)` / `test.use({ storageState: storageStateFor(persona) })` over this single var,
# which remains for a spec that wants one explicit state. A path that doesn't exist skips cleanly.
# E2E_STORAGE_STATE=./.auth/user1.json

# Postgres connection strings the seed (seed/seed.ts, run by globalSetup) writes to. Each already defaults to the
# local k3d cluster's Traefik raw-TCP entrypoint below, so a normal local checkout needs none of these. Three
# states per var, mirroring the product URLs:
#   unset               -> the local default below
#   set to "" (blank)   -> skip seeding that database this run (its rows are left untouched)
#   set to anything else -> overrides the default (e.g. to seed a different environment's DB)
# The same vars are read by the in-spec DB helpers (lib/db.ts), except a blank there falls back to the default —
# a spec that queries a database needs a real connection. Identity must be seeded for the sub-dependent seeds
# (web-novel grants/progress, novel-forge cleanup) and for the auth-setup logins to have users to sign in as.
# E2E_PG_URL_IDENTITY=postgresql://postgres:postgres@127.0.0.1:7070/identity
# E2E_PG_URL_MEMOIR=postgresql://postgres:postgres@127.0.0.1:7070/shadow_memoir
# E2E_PG_URL_PULSE=postgresql://postgres:postgres@127.0.0.1:7070/pulse
# E2E_PG_URL_WEB_NOVEL=postgresql://postgres:postgres@127.0.0.1:7070/web_novel
# E2E_PG_URL_NOVEL_FORGE=postgresql://postgres:postgres@127.0.0.1:7070/novel_forge
