# Base URLs for already-deployed Shadow Library services. There is no local compose deployment (see
# ../AGENTS.md) — every spec targets these directly and self-skips when its product's var is unset. Copy
# this file to `.env` and fill in what you have; leaving a var unset is a valid, deliberate way to opt a
# product out of a run.

E2E_IDENTITY_URL=https://identity.shadow-apps.com
E2E_NOVEL_FORGE_URL=https://<novel-forge-domain>
E2E_PULSE_URL=https://pulse.shadow-apps.com
E2E_WEB_NOVEL_URL=https://webnovel.shadow-apps.com

# Opt-in: runs api-health.spec.ts's GET .../health/live + .../health/ready checks against every
# configured product above. Unset (or any value other than "1") skips that file entirely — an ingress
# that doesn't expose these paths is a real finding, not something the suite should paper over.
E2E_API_HEALTH=1

# Path to a Playwright storage-state JSON (https://playwright.dev/docs/auth) for authenticated flows.
# Unset skips every authenticated spec with a clear reason. Not produced by anything in this workspace
# yet — a later phase adds the login flow that generates it.
E2E_STORAGE_STATE=./.auth/user.json
