{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git cat-file:*)",
      "Bash(git merge-base:*)",
      "Bash(git describe:*)",
      "Bash(git shortlog:*)",
      "Bash(git name-rev:*)",
      "Bash(git config --get:*)",
      "Bash(git config --list:*)",
      "Bash(git branch)",
      "Bash(git branch --list:*)",
      "Bash(git remote -v)",
      "Bash(git worktree list:*)",
      "Bash(git stash list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(du:*)",
      "Bash(tree:*)",
      "Bash(realpath:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(bun --version)",
      "Bash(bun pm ls:*)",
      "Bash(node --version)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker compose ps:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules"
    ],
    "baseRef": "head",
    "bgIsolation": "worktree"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/enforce-worktree.sh\"",
            "timeout": 10,
            "statusMessage": "Enforcing worktree isolation"
          }
        ]
      }
    ]
  }
}
